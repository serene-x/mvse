# Consumer app and admin reads
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Admin writes only. Never include this key in a client build.
SUPABASE_SERVICE_ROLE_KEY=

# Database migrations and auth configuration
SUPABASE_ACCESS_TOKEN=

# Optional admin video extraction
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional override when yt-dlp is not on PATH
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
