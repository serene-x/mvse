# Copy to .env (gitignored) and fill in. The main process loads this on startup.

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...                # used by the renderer for realtime + reads
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # main process only — bypasses RLS

# Anthropic (Claude — Vision + NLP)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Whisper transcription only)
OPENAI_API_KEY=sk-...

# Optional: override the path to yt-dlp if it isn't on PATH
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
